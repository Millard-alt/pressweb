# Copy this file to .env and fill in real values before running in production.

# Port the server listens on
PORT=4000

# Secret used to sign login tokens — change this to a long random string.
JWT_SECRET=d71RNzKyZkQlMiLL48yDGuHBXsriytQV

# The very first Owner account, created automatically the first time the
# server starts against an empty database. Change the password before
# deploying anywhere public.
OWNER_NAME=Millard
OWNER_USERNAME=millard
OWNER_PASSWORD=Thiongo@12

# Cloudinary (free — https://cloudinary.com) hosts every photo: article
# pictures AND editor self-portraits. Get these from Cloudinary Console.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# OneSignal (free — https://onesignal.com) powers the 🔔 push alerts.
# APP_ID is also entered in the Owner → Settings panel (that drives the
# in-browser subscribe prompt); REST KEY is used by the server to send.
ONESIGNAL_APP_ID=
ONESIGNAL_REST_KEY=

# --- Supabase Postgres (recommended for Render persistence) ---
# On Render's free tier the disk is wiped on every redeploy, so the built-in
# SQLite file would lose data. Pointing this at a free Supabase Postgres
# database makes all content survive deploys. See README "Moving to Supabase".
# Format: postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# DATABASE_URL=

# Optional: force a dark/light theme from the server (frontend still allows toggle)
# THEME=
