# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values.  NEVER commit the real .env
# -- backend/.gitignore already excludes it.
# ---------------------------------------------------------------------------

# Port the server listens on (Render injects its own PORT automatically).
PORT=4000

# Secret used to sign login tokens. Anyone who knows this can forge an Owner
# login, so use a long random string:  `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
JWT_SECRET=replace-with-a-long-random-string

# The first Owner account. Created automatically the FIRST time the server
# starts against an empty database. Changing these later does NOT change an
# existing account -- use the Admin panel for that.
OWNER_NAME=Millard
OWNER_USERNAME=admin
OWNER_PASSWORD=replace-with-a-strong-password

# --- Cloudinary (free plan) -- hosts article photos AND editor self-portraits.
# Dashboard -> Product Environment / API Keys.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- OneSignal (free plan) -- powers the push alerts.
# ONESIGNAL_APP_ID is also stored in the Admin panel (Owner -> Site settings),
# because the browser needs it to subscribe. ONESIGNAL_REST_KEY is server-only.
ONESIGNAL_APP_ID=
ONESIGNAL_REST_KEY=

# --- Supabase Postgres (free plan) -----------------------------------------
# REQUIRED on Render: its free tier wipes the container disk on every deploy,
# so the built-in SQLite file would lose all content. With this set, the app
# stores everything in Supabase and survives redeploys.
#
# Use the CONNECTION POOLER host, not `db.<ref>.supabase.co`: the direct host is
# IPv6-only and Render's free tier cannot reach it.
#
#   Supabase -> Connect -> Session pooler (or Transaction pooler) -> URI
#
#   postgresql://postgres.<project-ref>:<db-password>@aws-1-<region>.pooler.supabase.com:6543/postgres
#
# Leave this empty locally to run on SQLite with zero setup.
# Running `npm run check-db` verifies the string and tells you exactly what is wrong.
# DATABASE_URL=

# Optional: cap the Postgres pool size (default 5).
# PG_POOL_MAX=5
